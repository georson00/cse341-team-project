<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Kizuna Rail</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 2rem;
            background: #f4f6f8;
        }

        main {
            max-width: 1100px;
            margin: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        th,
        td {
            padding: 0.8rem;
            border: 1px solid #ddd;
            text-align: left;
        }

        th {
            background: #17365d;
            color: white;
        }

        .table-container {
            overflow-x: auto;
        }

        .actions {
            display: flex;
            gap: 0.5rem;
        }

        .action-button {
            padding: 0.5rem 0.8rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            color: white;
        }

        .edit-button {
            background-color: #17365d;
        }

        .edit-button:hover {
            background-color: #254b7c;
        }

        .delete-button {
            background-color: #b91c1c;
        }

        .delete-button:hover {
            background-color: #991b1b;
        }

        .action-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .success {
            color: #15803d;
        }

        .error {
            color: #b91c1c;
        }

        dialog {
            width: 90%;
            max-width: 600px;
            max-height: 85vh;
            overflow-y: auto;
            box-sizing: border-box;
            border: none;
            border-radius: 8px;
            padding: 1.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        dialog::backdrop {
            background: rgba(0, 0, 0, 0.5);
        }

        dialog h2 {
            margin-top: 0;
            color: #17365d;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            margin-bottom: 1rem;
        }

        .form-group label {
            font-weight: bold;
        }

        .form-group input,
        .form-group select {
            padding: 0.6rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            font: inherit;
        }

        .passenger-fields {
            padding: 1rem;
            border: 1px solid #ddd;
            border-radius: 6px;
            margin-bottom: 1rem;
            background: #f4f6f8;
        }

        .dialog-actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.75rem;
            margin-top: 1.5rem;
        }

        #add-passenger-button,
        #cancel-edit-button {
            padding: 0.5rem 0.8rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            cursor: pointer;
        }
    </style>
    <script src="/js/bookings-admin.js" defer></script>
</head>

<body>
    <main>
        <h1>Bookings Administration</h1>
        <form action="/logout" method="POST">
            <button type="submit">Sign Out</button>
        </form>

        <p id="status" role="status">Loading bookings...</p>
        <p id="action-message" role="status" aria-live="polite"></p>
        <div class="table-container">
            <table id="bookings-table" hidden>
                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Trip</th>
                        <th>Schedule</th>
                        <th>Ticket Class</th>
                        <th>Travel Day</th>
                        <th>Passengers</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="bookings-body"></tbody>
            </table>
        </div>
        <dialog id="edit-booking-dialog">
            <form id="edit-booking-form">
                <h2>Edit Booking</h2>

                <p>
                    Booking ID:
                    <strong id="edit-booking-id"></strong>
                </p>

                <div class="form-group">
                    <label for="edit-ticket-class">Ticket Class</label>

                    <select id="edit-ticket-class" required>
                        <option value="standard">Standard</option>
                        <option value="premium">Premium</option>
                        <option value="first">First</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="edit-selected-day">Travel Day</label>

                    <select id="edit-selected-day" required>
                        <option value="monday">Monday</option>
                        <option value="tuesday">Tuesday</option>
                        <option value="wednesday">Wednesday</option>
                        <option value="thursday">Thursday</option>
                        <option value="friday">Friday</option>
                        <option value="saturday">Saturday</option>
                        <option value="sunday">Sunday</option>
                    </select>
                </div>

                <h3>Passengers</h3>

                <div id="edit-passengers"></div>

                <button type="button" id="add-passenger-button">
                    + Add Passenger
                </button>

                <p id="edit-error" class="error" role="alert"></p>

                <div class="dialog-actions">
                    <button type="button" id="cancel-edit-button">
                        Cancel
                    </button>

                    <button type="submit" id="save-booking-button" class="action-button edit-button">
                        Save Changes
                    </button>
                </div>
            </form>
        </dialog>
    </main>
</body>

</html>