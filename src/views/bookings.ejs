
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Kizuna Rail</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 2rem;
            background: #f4f6f8;
        }

        main {
            max-width: 1100px;
            margin: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        th, td {
            padding: 0.8rem;
            border: 1px solid #ddd;
            text-align: left;
        }

        th {
            background: #17365d;
            color: white;
        }

        .table-container {
            overflow-x: auto;
        }

        .error {
            color: #b91c1c;
        }
    </style>
    <script src="/js/bookings-admin.js" defer></script>
</head>
<body>
    <main>
        <h1>Bookings Administration</h1>
        <form action="/admin/logout" method="POST">
    <button type="submit">Log Out</button>
</form>

        <p id="status" role="status">Loading bookings...</p>

        <div class="table-container">
            <table id="bookings-table" hidden>
                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Trip</th>
                        <th>Schedule</th>
                        <th>Ticket Class</th>
                        <th>Travel Day</th>
                        <th>Passengers</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody id="bookings-body"></tbody>
            </table>
        </div>
    </main>
</body>
</html>
