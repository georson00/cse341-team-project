<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Trips - Kizuna Rail' %></title>
</head>
<body>
  <main>
    <h1>Scenic Trips</h1>
    <p id="trips-status">Loading trips...</p>
    <ul id="trips-list"></ul>
  </main>

  <script>
    async function loadTrips() {
      const statusEl = document.getElementById('trips-status');
      const listEl = document.getElementById('trips-list');

      try {
        const res = await fetch('/api/trips');
        if (!res.ok) {
          throw new Error(`Request failed with status ${res.status}`);
        }

        const trips = await res.json();
        listEl.innerHTML = '';

        if (!Array.isArray(trips) || trips.length === 0) {
          statusEl.textContent = 'No trips available.';
          return;
        }

        statusEl.textContent = '';
        trips.forEach((trip) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = `/trips/${trip._id || trip.id || ''}`;
          link.textContent = trip.title || 'Untitled Trip';

          item.appendChild(link);
          if (trip.description) {
            const desc = document.createElement('span');
            desc.textContent = ` — ${trip.description}`;
            item.appendChild(desc);
          }

          listEl.appendChild(item);
        });
      } catch (err) {
        console.error('Error loading trips:', err);
        statusEl.textContent = 'Unable to load trips right now.';
      }
    }

    document.addEventListener('DOMContentLoaded', loadTrips);
  </script>
</body>
</html>
